# ====================================================================
# ECOTDEV DIGITAL STORE - ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Public)
# Get these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Site configuration
VITE_SITE_URL=http://localhost:5173
VITE_STORE_NAME=ECOTDEV DIGITAL STORE

# Payment Gateways (Client keys / Sandboxes)
VITE_ENABLE_SANDBOX_PAYMENTS=true
VITE_VNPAY_TMN_CODE=ECOTDEV_SANDBOX
VITE_MOMO_PARTNER_CODE=MOMO_SANDBOX

# 2. BACKEND / EDGE FUNCTIONS ONLY (NEVER EXPOSE IN FRONTEND .ENV)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_secret
# VNPAY_HASH_SECRET=your_vnpay_secret
# MOMO_SECRET_KEY=your_momo_secret
